# Password for the web panel (after changing it run: docker compose up -d)
PANEL_PASSWORD=change-me
# Key that signs panel sessions (generate one with: openssl rand -hex 32). Empty = a new one on every start
SECRET_KEY=
# Ports on this machine
PANEL_PORT=8091
MC_PORT=25565
# Address shown in the panel for players to connect: your playit.gg or DuckDNS address
# (empty = the address you open the panel with, plus MC_PORT)
MC_ADDRESS=your-domain.duckdns.org:25565
# Time zone for logs and daily backups, e.g. Europe/Madrid
TZ=UTC
